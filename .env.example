# สำหรับสรุปรายวันเข้า Telegram (08:00 และ 20:00 เวลาไทย)
# สร้างบอทกับ @BotFather เพื่อได้ TOKEN และหา chat id ได้จาก @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
FINNHUB_API_KEY=
POLYGON_API_KEY=
ADMIN_API_KEY=

DATABASE_URL=postgresql+psycopg://stock_radar:stock_radar@postgres:5432/stock_radar
REDIS_URL=redis://redis:6379/0

APP_ENV=development
LOG_LEVEL=INFO
# nasdaq = ดึงราคา EOD รายวันจริงฟรี ไม่ต้องใช้ key (เสถียรกว่า yahoo/stooq ที่มักโดน rate-limit)
MARKET_DATA_PROVIDER=nasdaq
USE_LIVE_DATA=true
ALLOW_MOCK_DATA=false
SEND_TELEGRAM=false
SAVE_SIGNALS=false
BACKEND_CORS_ORIGINS=http://localhost:3000
TOP_SIGNAL_LIMIT=5
# default = ชุด curated ~80 ตัว (large/mid cap) เหมาะกับ Nasdaq ที่ดึงทีละ symbol
# ใช้ all (~5,280 ตัว) ต่อเมื่อมี POLYGON_API_KEY ที่ดึง snapshot ทั้งตลาดใน 1 คำขอ
UNIVERSE_MODE=default
SCAN_UNIVERSE_LIMIT=0
SCAN_WORKERS=12
AI_CANDIDATE_LIMIT=50
# หุ้นเล็ก/หุ้นซิ่งที่ต้องให้หน้า /surge สแกนเสมอ เพิ่ม/ลดได้เอง
SURGE_EXTRA_SYMBOLS=MTEN,CUPR,HUBC,CHAI,AZI,VSME,DSY,PPCB,SUNE
SURGE_UNIVERSE_MODE=all
SURGE_UNIVERSE_LIMIT=0
SURGE_CANDIDATE_LIMIT=120
# หน้า /surge จะแสดงเฉพาะตัวที่วิ่งแรงอย่างน้อยกี่ %
SURGE_MIN_CHANGE_PERCENT=50
# ถ้าตัว 50%+ มีน้อย ให้เติมตัวรองลงมาที่วิ่งอย่างน้อยกี่ % และให้มีขั้นต่ำกี่ตัว
SURGE_BACKFILL_MIN_CHANGE_PERCENT=10
SURGE_MIN_RESULTS=50
# จำนวนหุ้น (curated large/mid cap) ที่วิเคราะห์สำหรับหน้า "ระยะยาว"
LONGTERM_SCAN_LIMIT=80

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# ใช้เฉพาะ dashboard ส่วนตัว/internal เท่านั้น เพราะ NEXT_PUBLIC_* จะถูกเปิดให้ browser เห็น
NEXT_PUBLIC_ADMIN_API_KEY=
